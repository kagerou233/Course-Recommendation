@startuml RecommendationEngine

skinparam classAttributeIconSize 0

package "推荐系统" {
    class RecommendationService {
        +recordUserInteraction()
        +getCollaborativeRecommendations()
        +getShortestPathRecommendations()
    }

    class CollaborativeFilter {
        -findSimilarUsers()
        -calculateSimilarity()
        -getRecommendationsFromSimilarUsers()
    }

    class ShortestPathFinder {
        -buildCourseGraph()
        -findShortestPath()
        -getCoursesByCategory()
    }

    class UserInteraction {
        +Integer userId
        +Integer courseId
        +String interactionType
        +Float score
        +DateTime timestamp
    }
}

RecommendationService --> CollaborativeFilter
RecommendationService --> ShortestPathFinder
UserInteraction --> RecommendationService

@enduml
