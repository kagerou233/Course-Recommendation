        </mxCell>
        <mxCell id="28" value="查找相似用户&#xa;用户A: 1门共同&#xa;用户B: 2门共同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
