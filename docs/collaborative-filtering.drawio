        </mxCell>
        <mxCell id="26" value="获取用户S已交互的课程&#xa;{课程1, 课程2}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
