          <mxGeometry x="570" y="275" width="150" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Step 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42b883;strokeColor=#333333;fontSize=11;fontColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="325" width="60" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="推荐课程5给用户S&#xa;(按推荐次数排序)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#cc7a00;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="570" y="325" width="150" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Cypher查询" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#1a1a1a" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="MATCH (s:Student {student_id: $userId})&#xa;-[r1:INTERACTED_WITH]->(c:Course)&#xa;WITH s, collect(c) as userCourses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="780" y="165" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="MATCH (s)-[r:INTERACTED_WITH]->(c:Course)&#xa;<-[r2:INTERACTED_WITH]-(other:Student)&#xa>WHERE other <> s&#xa>WITH s, other, count(c) as commonCourses&#xa>ORDER BY commonCourses DESC LIMIT 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="780" y="225" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="MATCH (other)-[r3:INTERACTED_WITH]->(rec:Course)&#xa>WHERE NOT rec IN userCourses&#xa>WITH rec, count(DISTINCT other) as recCount&#xa>ORDER BY recCount DESC LIMIT 10&#xa;RETURN rec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="780" y="295" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="37" value="算法优势" style="swimlane;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;startSize=18" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="• 无需了解课程内容特征，仅依靠用户行为&#xa;• 能够发现用户潜在兴趣（惊喜推荐）&#xa;• 算法成熟，易于理解和实现&#xa;• 利用Neo4j图数据库能高效查询多跳关系" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#333333;spacingLeft=5" vertex="1" parent="37">
          <mxGeometry x="10" y="35" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="39" value="算法局限" style="swimlane;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;startSize=18" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="40" value="• 冷启动问题：新用户无历史数据时难以推荐&#xa;• 稀疏性问题：用户-课程交互矩阵稀疏时效果差&#xa;• 热门偏好：倾向于推荐热门课程&#xa;• 无法推荐新上架的课程（无交互数据）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#333333;spacingLeft=5" vertex="1" parent="39">
          <mxGeometry x="10" y="35" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="技术实现" style="swimlane;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;startSize=18" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="后端实现" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1" vertex="1" parent="41">
          <mxGeometry x="10" y="30" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="neo4j.controller.js&#xa;getCollaborativeRecommendations()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;fontSize=10" vertex="1" parent="41">
          <mxGeometry x="10" y="55" width="150" height="40" as="geometry"/>
