        </mxCell>
        <mxCell id="legNote" value="冷启动: 新用户无交互记录时，采用热门推荐、学科推荐等策略" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontColor=#666666" vertex="1" parent="legend">
          <mxGeometry x="20" y="75" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="queryBox" value="Cypher查询示例" style="swimlane;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;startSize=18" vertex="1" parent="1">
          <mxGeometry x="1150" y="100" width="500" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="query1Title" value="协同过滤:" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=1;fontColor=#333333" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="35" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="query1" value="MATCH (s:Student {student_id: $userId})-[:INTERACTED_WITH]->(c:Course)&#xa;WITH s, collect(c) as userCourses&#xa;&#xa;MATCH (s)-[:INTERACTED_WITH]->(c:Course)<-[:INTERACTED_WITH]-(other:Student)&#xa;WHERE other <> s&#xa;WITH s, other, count(c) as common ORDER BY common DESC LIMIT 10&#xa;&#xa;MATCH (other)-[:INTERACTED_WITH]->(rec:Course)&#xa;WHERE NOT rec IN userCourses&#xa;RETURN rec, count(DISTINCT other) as score ORDER BY score DESC LIMIT 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8;fontFamily=Courier New;align=left" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="55" width="480" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="query2Title" value="最短路:" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=1;fontColor=#333333" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="165" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="query2" value="MATCH (s:Student {student_id: $userId})-[:ENROLLED_IN]->(c:Course)&#xa;MATCH path = (c)-[:CONTAINS*1..3]->(rec:Course)&#xa;WHERE NOT (s)-[:ENROLLED_IN]->(rec)&#xa;RETURN rec, min(length(path)) as distance ORDER BY distance ASC LIMIT 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8;fontFamily=Courier New;align=left" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="185" width="480" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="query3Title" value="热门推荐(冷启动):" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=1;fontColor=#333333" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="265" width="130" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="query3" value="MATCH (c:Course)&#xa;WHERE c.level = 'beginner'&#xa;RETURN c ORDER BY c.published_at DESC LIMIT 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8;fontFamily=Courier New;align=left" vertex="1" parent="queryBox">
          <mxGeometry x="10" y="285" width="480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="weightBox" value="结果融合权重" style="swimlane;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;startSize=16" vertex="1" parent="1">
          <mxGeometry x="1150" y="520" width="500" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="weightFormula" value="最终分数 = 0.6 x 协同过滤分数 + 0.4 x 最短路分数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;fontSize=11;fontFamily=Courier New" vertex="1" parent="weightBox">
