@startuml CompleteClassDiagram

skinparam componentStyle uml2
skinparam backgroundColor #FEFEFE

package "服务器层" {
    [app.js\nExpress服务器] as App {
        -initDb()
        -setupCors()
        -registerRoutes()
        -listen(port)
    }
}

package "路由层" {
    [neo4j.routes.js] as Neo4jRoutes {
        +GET /users
        +GET /users/:name
        +POST /relations/friend
        +GET /course
        +GET /course/category/:category
        +GET /disciplines
        +POST /interactions
        +GET /recommendations/collaborative/:userId
        +GET /recommendations/shortest-path/:userId
    }

    [auth.routes.js] as AuthRoutes {
        +POST /register
        +POST /login
        +GET /profile
        +POST /logout
    }
}

package "控制器层" {
    [neo4j.controller.js] as Neo4jController {
        +createUser()
        +getUsers()
        +getUserByName()
        +updateUser()
        +deleteUser()
        +createFriendRelation()
        +getAllRelations()
        +getAllCourses()
        +getCoursesByCategory()
        +deleteCourse()
        +getDisciplines()
        +updateDisciplineName()
        +recordUserInteraction()
        +getCollaborativeRecommendations()
        +getShortestPathRecommendations()
    }

    [sqlite.js] as SqliteController {
        +initDb()
        +getUserById()
        +getUserByUsername()
        +createUser()
        +userPublic()
    }

    [syncStudentToNeo4j.js] as SyncService {
        +syncRegisteredStudent()
    }
}

package "数据层" {
    [neo4j Driver] as Neo4jDriver {
        +session()
        +run(cypher)
        +close()
    }

    database "SQLite" as SQLite {
        table users
    }

    database "Neo4j" as Neo4jDB {
        node Student
        node Course
        node Discipline
        node SubDiscipline
        rel ENROLLED_IN
        rel INTERACTED_WITH
        rel FRIEND
        rel CONTAINS
    }
}

App --> Neo4jRoutes : uses
App --> AuthRoutes : uses
Neo4jRoutes --> Neo4jController : delegates
AuthRoutes --> SqliteController : queries
AuthRoutes --> SyncService : syncs
Neo4jController --> Neo4jDriver : queries
SqliteController --> SQLite : queries
SyncService --> Neo4jDriver : syncs

@enduml
