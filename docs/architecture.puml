@startuml Architecture

skinparam componentStyle uml2

package "Server Layer" {
    [app.js\nExpress Server] as App
}

package "Route Layer" {
    [neo4j.routes.js] as Neo4jRoutes
    [auth.routes.js] as AuthRoutes
}

package "Controller Layer" {
    [neo4j.controller.js] as Neo4jController
    [sqlite.js\nDatabase] as SqliteDB
}

package "Data Layer" {
    [neo4j Driver] as Neo4jDriver
    [SQLite\nDatabase] as SQLite
}

App --> Neo4jRoutes : uses
App --> AuthRoutes : uses
Neo4jRoutes --> Neo4jController : calls
AuthRoutes --> SqliteDB : calls
Neo4jController --> Neo4jDriver : executes queries

@enduml
