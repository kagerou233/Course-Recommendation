@startuml Frontend Architecture
!theme plain

title 前端架构图 (Frontend Architecture)

package "入口层 (Entry)" {
  [index.html] as indexHtml
  [index.js] as indexJs
  [app.js] as appJs
}

package "根组件 (Root Component)" {
  [App.vue] as App
}

package "路由层 (Vue Router)" <<Rectangle>> {
  database "router/index.js" as routerConfig
  card "/, /login, /learning, /main, /admin/*, /neo4j" as routes
}

package "视图层 (Views)" <<Rectangle>> {
  card "Login.vue\n登录页" as LoginView
  card "LearningResources.vue\n课程学习" as LearningView
  card "Main.vue\n主页" as MainView
  card "neo4j.vue\n图数据" as Neo4jView

  package "管理视图 (Admin)" <<Rectangle>> {
    card "AdminLayout.vue\n管理布局" as AdminLayout
    card "ResourceManagement\n资源管理" as ResourceMgmt
    card "UserManagement\n用户管理" as UserMgmt
    card "CategoryManagement\n分类管理" as CategoryMgmt
    card "PlaceholderPage\n标签管理" as TagMgmt
  }

  package "其他视图" <<Rectangle>> {
    card "echarts/knowlegGraph.vue" as EchartsView
    card "page/AuthorArticleSearch" as AuthorSearch
    card "page/pageNeovis" as PageNeovis
  }
}

package "组件层 (Components)" <<Rectangle>> {
  component "Search.vue\n搜索组件" as SearchComp

  package "D3Visualization 组件库" {
    component "Visualization.vue\n主图谱组件" as VizMain
    component "Graph.vue" as Graph
    component "Explorer.vue" as Explorer
    component "Inspector.vue" as Inspector
    component "Legend.vue" as Legend
    component "GraphEventHandler.js" as EventHandler
    component "mapper.js" as Mapper
    component "graphStyle.js" as GraphStyle
    component "services/bolt/" as BoltService
  }
}

package "外部依赖 (External Dependencies)" <<Rectangle>> {
  component "Vue.js 2.x" as Vue
  component "Vue Router" as VueRouter
  component "Axios" as Axios
  component "D3.js" as D3
  component "Neo4j Driver" as Neo4jDriver
  component "NeoVis.js" as NeoVis
  component "ECharts" as ECharts
  component "Webpack" as Webpack
}

package "静态资源 (Static)" {
  folder "static/css/" as StaticCss
  folder "static/js/external/" as StaticJs
}

' 关系连接
indexHtml --> indexJs
indexJs --> appJs
appJs --> App
App --> routerConfig
routerConfig --> routes
routes --> LoginView
routes --> LearningView
routes --> MainView
routes --> Neo4jView
routes --> AdminLayout
AdminLayout --> ResourceMgmt
AdminLayout --> UserMgmt
AdminLayout --> CategoryMgmt
AdminLayout --> TagMgmt

routes --> EchartsView
routes --> AuthorSearch
routes --> PageNeovis

LearningView --> SearchComp
Neo4jView --> VizMain
VizMain --> Graph
VizMain --> Explorer
VizMain --> Inspector
VizMain --> Legend
VizMain --> EventHandler
VizMain --> Mapper
VizMain --> GraphStyle
VizMain --> BoltService

SearchComp --> Axios
VizMain --> D3
VizMain --> Neo4jDriver
EchartsView --> ECharts
PageNeovis --> NeoVis

App --> Vue
App --> VueRouter
App --> Axios

@enduml
